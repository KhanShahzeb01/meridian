# Local dev with optional full rallies backend (uncomment to enable):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# GitHub Pages build sets this automatically (/meridian)
# NEXT_PUBLIC_BASE_PATH=/meridian

# OpenRouter model (browser-direct, like Plexus)
# NEXT_PUBLIC_OPENROUTER_MODEL=openai/gpt-oss-120b:free
